<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="emailListPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <!-- Khai báo Entity User của bạn -->
        <class>murach.business.User</class>

        <properties>
            <!-- Driver kết nối PostgreSQL -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

            <!-- JDBC URL đã thêm tham số ?sslmode=require để qua được tường lửa public của Railway -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://altaria.proxy.rlwy.net:41964/railway?sslmode=require&amp;connectTimeout=30"/>
            <!-- Username -->
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>

            <!-- Password -->
            <property name="jakarta.persistence.jdbc.password" value="rkbpouPmEeHlGKTGTCRzguZnmlkzqm"/>

            <!-- Cấu hình tùy chọn tự động cập nhật bảng -->
            <property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>
        </properties>
    </persistence-unit>
</persistence>