<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="emailListPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <class>murach.business.User</class>

        <properties>
            <!-- Thay đổi URL kết nối bên dưới bằng Internal Database URL của Render -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://<RENDER_HOST>:<PORT>/<DATABASE_NAME>?currentSchema=public&amp;TimeZone=Asia/Ho_Chi_Minh"/>
            <property name="jakarta.persistence.jdbc.user" value="<USER>"/>
            <property name="jakarta.persistence.jdbc.password" value="<PASSWORD>"/>

            <!-- Cấu hình tạo/cập nhật bảng tự động của EclipseLink -->
            <property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>
            <property name="eclipselink.logging.level" value="INFO"/>
        </properties>
    </persistence-unit>
</persistence>